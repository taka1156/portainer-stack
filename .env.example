##############################
# SSH
##############################
HOST=xxx.xxx.xxx.xxx
USER=hoge
PORT=22
KEY=/root/.ssh/your-key.pem

##############################
# Cloudflare Tunnel (optional)
##############################
ENABLE_TUNNEL=false
# SUBDOMAIN=subdomain
# DOMAIN=example.com

##############################
# Ansible
##############################
# sudo password for the remote user (required)
SUDO_PASS=your-sudo-password-here
# Cloudflare Tunnel token (required when enable_cloudflare_tunnel=true)
# CF_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
